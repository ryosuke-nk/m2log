{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/assets/video/:file", "destination": "/video/:file" }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/pages/:slug.html", "destination": "/:slug", "permanent": true },
    { "source": "/pages/:slug", "destination": "/:slug", "permanent": true }
  ]
}
